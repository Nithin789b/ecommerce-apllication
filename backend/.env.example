PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/ecommerce?replicaSet=rs0
# Optional local DNS workaround only; leave unset on deployment hosts.
# MONGODB_DNS_SERVERS=8.8.8.8,8.8.4.4
SEED_USER_ID=seed_user_id 
TEST_MONGODB_URI=mongodb://127.0.0.1:27017/ecommerce_test?replicaSet=rs0
ACCESS_TOKEN_SECRET=replace-with-a-long-random-secret
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
NODE_ENV=development
CLIENT_URL=http://localhost:5173
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
EMAIL_FROM=ShopVerse <no-reply@example.com>
# Local Postman testing only. Set to false in production.
RESET_PASSWORD_RETURN_LINK=false
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_UPLOAD_TIMEOUT_MS=120000
